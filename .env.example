# 로컬 실행용 환경 변수 예시. .env로 복사해서 쓴다(.env는 커밋 금지)
# 클라우드 세션·HF Space에서는 파일 대신 환경 설정(시크릿)에 같은 이름으로 등록한다

# 필수: 질문 임베딩(text-embedding-3-small), Gemini 답변·요약, 벡터 검색
OPENAI_API_KEY=
GOOGLE_API_KEY=
PINECONE_API_KEY=

# 선택: 줄을 지우면 아래 값이 기본값으로 쓰인다(빈 값으로 두지 말 것)
PINECONE_INDEX_NAME=mind-lantern
CHAT_MODEL=gemini-2.5-flash
SUMMARY_MODEL=gemini-2.5-pro

# 데이터 파이프라인(data-*.py)용 Google Drive 폴더 ID
GOOGLE_DRIVE_VTT_ID=
GOOGLE_DRIVE_TXT_ID=
GOOGLE_DRIVE_RT_ID=
